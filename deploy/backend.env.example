# Production values for /var/www/jamshan-store/backend/.env on the Contabo server.
# (Django reads this file automatically — see config/settings.py.)
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=put-a-long-random-string-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=www.jamshan.com,jamshan.com,127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=https://www.jamshan.com,https://jamshan.com
FRONTEND_URL=https://www.jamshan.com

# PostgreSQL on the same server
DATABASE_URL=postgres://jamshan_user:DB_PASSWORD@127.0.0.1:5432/jamshan_db

# Product images (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Order emails (Resend)
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=JH Store <orders@jamshan.com>
ADMIN_EMAIL=jamshankalair398@gmail.com

# Optional WhatsApp order alerts
CALLMEBOT_PHONE=923714905398
CALLMEBOT_APIKEY=

# Meta Conversions API (server-side Purchase event) — optional
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
