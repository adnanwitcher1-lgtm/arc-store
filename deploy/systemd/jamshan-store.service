# Reference copy of the unit that runs on the Contabo server (from the 2026-11-08 backup).
# Install: sudo cp deploy/systemd/jamshan-store.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now jamshan-store
# Note: backend/.env must be readable by www-data:  chgrp www-data backend/.env && chmod 640 backend/.env
[Unit]
Description=Jamshan Store Gunicorn
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/jamshan-store/backend
Environment=HOME=/var/www/jamshan-store
ExecStart=/var/www/jamshan-store/backend/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8004 --workers 2
Restart=always

[Install]
WantedBy=multi-user.target
