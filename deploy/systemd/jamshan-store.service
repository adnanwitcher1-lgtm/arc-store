# REFERENCE ONLY — the jamshan-store service already runs on your server. Check yours with:
#   systemctl cat jamshan-store
# Only use this file if you are setting the backend up from scratch (adjust paths/user first).
[Unit]
Description=JH Store (jamshan) Django API — Gunicorn on 127.0.0.1:8004
After=network.target postgresql.service

[Service]
User=root
WorkingDirectory=/var/www/jamshan-store/backend
ExecStart=/var/www/jamshan-store/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8004 --workers 3 --timeout 60
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
