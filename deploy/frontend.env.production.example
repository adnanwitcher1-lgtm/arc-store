# Copy to /var/www/jamshan-store/frontend/.env.production, then run deploy/deploy.sh.
# Vite bakes these into the build, so rebuild after changing anything here.
VITE_API_URL=https://api.jamshan.com/api
VITE_SITE_URL=https://www.jamshan.com

# Meta (Facebook) Pixel ID
VITE_META_PIXEL_ID=

# Google Analytics 4 (G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Verification codes — only the "content" value of each meta tag
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
VITE_META_DOMAIN_VERIFICATION=
