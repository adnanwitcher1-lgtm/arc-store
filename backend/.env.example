DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email — leave blank to just print emails to the console (fine for local testing).
# Fill these in to send real emails (see DEPLOYMENT.md for the Gmail App Password steps).
# EMAIL_HOST_USER must be the FULL Gmail address (not a name) — e.g. mumtazahmadfaheem@gmail.com
# EMAIL_HOST_PASSWORD is the 16-character App Password with the SPACES REMOVED — e.g. abcdefghijklmnop
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
ADMIN_EMAIL=mumtazahmadfaheem@gmail.com

# Optional — WhatsApp order alerts via CallMeBot (see DEPLOYMENT.md). Leave blank to skip.
CALLMEBOT_PHONE=923714905398
CALLMEBOT_APIKEY=
