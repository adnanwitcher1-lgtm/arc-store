# Production values: see deploy/frontend.env.production.example
VITE_API_URL=http://127.0.0.1:8000/api

# Meta (Facebook) Pixel ID — events: PageView, ViewContent, AddToCart, InitiateCheckout, AddPaymentInfo, Purchase, Search, AddToWishlist, CompleteRegistration, Lead, Contact
VITE_META_PIXEL_ID=

# Public storefront URL (no trailing slash) — canonical links, sitemap, structured data
VITE_SITE_URL=

# Google Analytics 4 — Measurement ID (GA4 → Admin → Data streams), e.g. G-XXXXXXXXXX. Mirrors every Meta event.
VITE_GA_MEASUREMENT_ID=

# Verification codes (only the "content" value of the meta tag each service gives you)
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
VITE_META_DOMAIN_VERIFICATION=
